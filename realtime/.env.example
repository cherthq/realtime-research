# Backend only. Copy to realtime/.env and fill privately. Never use VITE_ keys.
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
INPUT_TRANSCRIPTION_MODEL=gpt-live-transcribe
INPUT_TRANSCRIPTION_LANGUAGE=en
VOICE_SILENCE_DURATION_MS=350
CAMERA_VISION=true
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_v4_turbo
# Optional 0..1 stability override; omit to preserve the saved voice default.
# ELEVENLABS_STABILITY=0.4
# Wait at most this long for an unfinished clause; complete sentences never wait.
ELEVENLABS_PHRASE_WAIT_MS=120
# Optional research fallback; the ten demo portraits already have stock voices.
ELEVENLABS_VOICE_ID=
AVATAR_CATALOG=demo
SESSION_LIMIT_SECONDS=600
CONTROL_TRANSPORT=poll
WEB_SEARCH_ENABLED=false
WEB_SEARCH_MODEL=gpt-4.1-mini
WEB_SEARCH_TIMEOUT_SECONDS=8
WEB_SEARCH_CACHE_SECONDS=60
# Enable after GPU installation and weight download.
AVATARFOREVER_ENABLED=false
AVATARFOREVER_COMPILE_BLOCKS=true
AVATARFOREVER_CACHE_PROMPT=true
AVATARFOREVER_LISTENING_PROFILE=onset_boost
AVATAR_CONTINUOUS_MOTION=true
AVATAR_IDLE_MOTION=false
AVATAR_STARTUP_BUFFER_MS=480
GPU_LOAD_TIMEOUT_SECONDS=900
GPU_CHUNK_TIMEOUT_SECONDS=60
# Set in launch environment before imports: 512x384 or 640x480.
# AVATAR_RESOLUTION=512x384
# AVATARFOREVER_PYTHON=/absolute/path/to/.venv-avatarforever/bin/python
# AVATARFOREVER_WEIGHTS=/absolute/path/to/checkpoints/avatarforever
# The demo_host launcher supplies a private generated code; the public gateway
# keeps that code server-side. Direct app launches can set their own code here.
DEMO_ACCESS_TOKEN=
# Optional research-only paths and open-weight speech:
# STATE_DIR=/private/data/realtime
# ASSETS_DIR=/private/data/eval/facetime-zero-shot-v1
# QWEN_TTS_URL=http://127.0.0.1:18920
