# Local self-hosted LiveKit. No account is needed for this localhost-only profile.
LIVEKIT_URL=ws://127.0.0.1:7880
# Optional browser-facing signaling URL when SSH uses a private WSL interface.
# LIVEKIT_BROWSER_URL=ws://<private-WSL-IPv4>:19882
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# Add privately to realtime/.env when ready. Never use VITE_ prefixes for secrets.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_CASTING_MODEL=gpt-5.6-terra
# Prepared profiles/assignments are cached here (ignored by Git).
# STATE_DIR=data/realtime
# Default images and fixed replay audio. Import the asset-only handoff pack first.
# ASSETS_DIR=/absolute/path/to/data/eval/facetime-zero-shot-v1
# This is the demo call duration, independent of voice reply tokens.
SESSION_LIMIT_SECONDS=600
# Explicit deployment configuration is required before exposing this beyond localhost.
# Optional private access code. The SSH host helper supplies a generated value.
# Browser entry uses an HttpOnly cookie; do not add this to frontend variables.
DEMO_ACCESS_TOKEN=

# Explicit opt-in only on a prepared GPU host. No weights are downloaded on start.
# This enables an experimental adapter, not a realtime performance certification.
AVATARFOREVER_ENABLED=false
# Optional regional compilation; prewarm before opening the browser demo.
# Keep a 900s load allowance for the first compile; warm inference is separate.
AVATARFOREVER_COMPILE_BLOCKS=false
# AVATARFOREVER_PYTHON=/absolute/path/to/.venv-avatarforever/bin/python
# AVATARFOREVER_WEIGHTS=/absolute/path/to/checkpoints/avatarforever
GPU_LOAD_TIMEOUT_SECONDS=300
GPU_CHUNK_TIMEOUT_SECONDS=60
